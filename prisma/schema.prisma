// Prisma schema for Idle City Builder game
// SQLite provider for local sandbox execution, fully compatible with Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  password_hash String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // 1-to-1 relationship with City
  city City?

  // Bridge connections (social alliance system)
  sentBridges     BridgeConnection[] @relation("SentBridges")
  receivedBridges BridgeConnection[] @relation("ReceivedBridges")

  @@index([username])
}

model City {
  id             String   @id @default(cuid())
  user_id        String   @unique
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  balance        Float    @default(500.0) // Starter cash for initial constructions
  population     Int      @default(0)
  last_sync_time DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // 1-to-many relationship with Buildings
  buildings Building[]

  @@index([population])
  @@index([last_sync_time])
}

model Building {
  id         String   @id @default(cuid())
  city_id    String
  city       City     @relation(fields: [city_id], references: [id], onDelete: Cascade)
  type       String   // e.g. "RESIDENTIAL_SMALL", "RESIDENTIAL_TOWER", "COMMERCIAL_SHOP", "COMMERCIAL_MALL"
  level      Int      @default(1)
  grid_x     Int      // Tile column index
  grid_y     Int      // Tile row index
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Guarantees only one building per grid coordinate in a city
  @@unique([city_id, grid_x, grid_y])
  @@index([city_id])
}

model BridgeConnection {
  id         String   @id @default(cuid())
  user_a_id  String   // Requester user ID
  user_b_id  String   // Target user ID
  user_a     User     @relation("SentBridges", fields: [user_a_id], references: [id], onDelete: Cascade)
  user_b     User     @relation("ReceivedBridges", fields: [user_b_id], references: [id], onDelete: Cascade)
  status     String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Ensures a user cannot send duplicate bridge invitations to the same player
  @@unique([user_a_id, user_b_id])
  @@index([user_a_id, status])
  @@index([user_b_id, status])
}
